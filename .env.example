# Copy to ~/.pi/agent/.env and fill values.
# This repo's custom extensions read this file directly.
# Model/provider auth still uses Pi's normal /login, auth.json, or exported env flow.

# Primary webResearch / auto-research provider. DuckDuckGo fallback works without a key.
TAVILY_API_KEY=

# Optional auto-research tuning
# PI_AUTO_RESEARCH_WEB_PROVIDER=tavily
# PI_AUTO_RESEARCH_MAX_SOURCES=8
# PI_AUTO_RESEARCH_DIR=$HOME/.pi/agent/research

# Optional paper-search courtesy / higher quota
# PI_RESEARCH_CONTACT_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=
