# Copy to ~/.pi/agent/.env and fill values.
# This repo's custom extensions read this file directly.
# Model/provider auth still uses Pi's normal /login, auth.json, or exported env flow.

# Primary webResearch / auto-research providers. DuckDuckGo fallback works without a key.
# Auto order: Tavily if configured, then Firecrawl if configured, then DuckDuckGo.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Optional usage endpoint overrides and timeout
# FIRECRAWL_USAGE_URL=https://api.firecrawl.dev/v2/team/credit-usage
# TAVILY_USAGE_URL=https://api.tavily.com/usage
# PI_EXTERNAL_USAGE_TIMEOUT_MS=15000

# Optional auto-research tuning
# PI_AUTO_RESEARCH_WEB_PROVIDER=tavily
# PI_AUTO_RESEARCH_MAX_SOURCES=8
# PI_AUTO_RESEARCH_DIR=$HOME/.pi/agent/research
# PI_AUTO_RESEARCH_PAPER_PROVIDERS=openalex,semanticscholar,arxiv,crossref

# Optional paper-search courtesy / higher quota
# PI_RESEARCH_CONTACT_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=
